# IPv4 address clients should connect to. Use this machine's public IP.
PUBLIC_IP=

# Admin account. Used only to create the first admin row in the database.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-now

# Resolvers for names that are not on the list, and for the proxy's own lookups.
# IP addresses only, so this server never has to ask itself.
UPSTREAM_DNS=1.1.1.1,8.8.8.8

# Optional extra names. Added with the built-in list only when the database is empty.
# SEED_DOMAINS=example.com,*.example.com

# LOG_LEVEL=debug
